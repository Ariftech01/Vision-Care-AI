# Vision Care AI — Environment Configuration Example

# Frontend Server
PORT=3000
NODE_ENV=development

# Backend Inference Server
VITE_API_URL=http://127.0.0.1:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Device Configuration ('auto', 'cuda', 'cpu')
DEVICE=auto

# Frozen Referable Decision Threshold (Do not change: calibrated at 0.24)
REFERABLE_THRESHOLD=0.24
